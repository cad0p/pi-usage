{
  "name": "@cad0p/pi-usage",
  "version": "0.11.4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Read-only usage/quota for the AI subscriptions Pi already owns (Claude, Codex, multi-account OpenCode Go, Antigravity): /usage in Pi and the Omarchy Agents panel. Fork of @j3pf/piquota.",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "piquota": "./bin/piquota.js"
  },
  "files": [
    "bin",
    "src",
    "extensions",
    "omarchy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "quota",
    "ai-agents",
    "rate-limits",
    "claude",
    "codex",
    "antigravity",
    "opencode",
    "usage",
    "omarchy",
    "opencode-go",
    "multi-account"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cad0p/pi-usage.git"
  },
  "bugs": {
    "url": "https://github.com/cad0p/pi-usage/issues"
  },
  "homepage": "https://github.com/cad0p/pi-usage#readme",
  "pi": {
    "extensions": [
      "./extensions/quota-panel.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "quota": "node bin/piquota.js",
    "quota:json": "node bin/piquota.js --json"
  },
  "license": "MIT",
  "contributors": [
    "J3pf (https://github.com/J3pf)",
    "Pier Carlo Cadoppi (https://github.com/cad0p)"
  ]
}
